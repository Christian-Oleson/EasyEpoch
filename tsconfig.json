{
  "compilerOptions": {
    "outDir": "./dist/",
    "module": "commonjs",
    "lib": [
      "es6",
      "dom",
      "es2017"
    ],
    "target": "es2017",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    // Element fields are assigned in init() (called from the constructor),
    // which definite-assignment analysis cannot follow.
    "strictPropertyInitialization": false,
    "declaration": true,
    "rootDir": "lib"
  },
  "exclude": [
    "node_modules",
    "tests"
  ],
  "include": [
    "lib/**/*.ts"
  ]
}
