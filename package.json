{
  "name": "easyepoch",
  "version": "2.1.0",
  "description": "A lightweight datetime picker in vanilla JavaScript with zero dependencies.",
  "main": "./dist/easyepoch.node.js",
  "module": "./dist/easyepoch.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.esm.d.ts",
        "default": "./dist/easyepoch.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/easyepoch.node.js"
      },
      "default": "./dist/easyepoch.node.js"
    },
    "./css": "./dist/easyepoch.css"
  },
  "scripts": {
    "start": "rspack serve --hot",
    "prepack": "npm run build",
    "build": "rspack build --mode production --env production && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint lib/",
    "verify:dist": "npm run build && git diff --exit-code --stat -- dist/",
    "test:e2e": "npm run build && playwright test"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Christian-Oleson/EasyEpoch.git"
  },
  "keywords": [
    "date",
    "picker",
    "datepicker",
    "date-picker",
    "datetime",
    "datetime-picker",
    "vanilla-js",
    "no-dependencies"
  ],
  "author": "Christian Oleson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Christian-Oleson/EasyEpoch/issues"
  },
  "homepage": "https://github.com/Christian-Oleson/EasyEpoch#readme",
  "funding": {
    "type": "buymeacoffee",
    "url": "https://www.buymeacoffee.com/christianoleson"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@rspack/cli": "^2.0.0",
    "@rspack/core": "^2.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.1.0",
    "eslint-plugin-security": "^4.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
